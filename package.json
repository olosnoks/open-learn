{
  "name": "live-quiz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply quiz-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quiz-db --remote",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.50.0",
    "@xstate/react": "^4.1.0",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^2.5.0",
    "xstate": "^5.13.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.0",
    "@cloudflare/workers-types": "^5.20261119.1",
    "@playwright/test": "^1.46.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.164.0"
  }
}
