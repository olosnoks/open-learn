{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "live-quiz",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quiz-db",
      "database_id": "756d3e9b-e02d-4253-bcb3-5bb86b6e8625",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  // Per-IP throttle for POST /api/auth/login and /register: 1 request per minute.
  // Free on every plan. Skipped for loopback clients (local dev, e2e); see worker/auth/rateLimit.ts.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 1, "period": 60 } }
  ],
  "vars": { "ENVIRONMENT": "development" }
}
